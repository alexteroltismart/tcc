# ================================================================ 6. modelo estático
s = next(cont)
title(s, "Modelo estático: balanço de vazões num nó de pressão")
image(s, BFIG / "fig06.png", 0.6, 2.5, w=12.1, name="Circuito equivalente")
y0 = 2.5 + 12.1 / 6.32 + 0.25
cards = [("Bico (lei de orifício)", "q = K\\sqrt{P}", "K = 0,425 (média da Tabela 1)"),
         ("Fonte (bomba + PCV)", "P = a_2 Q_s^2 + a_1 Q_s + a_0", "mínimos quadrados, R² = 0,9999"),
         ("Válvula de alívio", "Q_v = K_{v,max}\\,\\alpha\\,\\sqrt{P}", "linear na abertura (H5)")]
for i, (cab, tex, rod) in enumerate(cards):
    x = 0.6 + i * 4.1
    box(s, x, y0, 3.9, 1.65, name=f"Cartão {cab}")
    text(s, x + 0.15, y0 + 0.08, 3.6, 0.4, [{"t": cab, "b": True, "s": 15, "c": NAVY}], name="Cabeçalho")
    add_eq(s, f"est{i}", tex, x + 0.2, y0 + 0.55, size=20, max_w=3.5)
    text(s, x + 0.15, y0 + 1.2, 3.6, 0.4, [{"t": rod, "s": 12, "c": MUTED}], name="Nota")
box(s, 0.6, y0 + 1.85, 12.1, 0.95, fill=RGBColor(0xE6, 0xF2, 0xEA), name="Balanço")
text(s, 0.8, y0 + 1.92, 4.2, 0.8, [{"t": "Equilíbrio no nó, resolvido por bissecção:", "b": True, "s": 15, "c": GREEN}],
     anchor=MSO_ANCHOR.MIDDLE, name="Balanço texto")
add_eq(s, "balanco", "Q_s(P) = \\left(n\\,K + K_{v,max}\\,\\alpha\\right)\\sqrt{P}", 5.2, y0 + 2.0, size=22, max_w=7.2)
notes(s, "Três caminhos se encontram num único nó de pressão: a fonte empurra líquido, os bicos e a válvula deixam sair. Em regime, entra = sai. Essa equação não tem solução direta para P e é resolvida por bissecção. Hipóteses: escoamento permanente, perda na barra desprezível, bicos iguais, fonte de segundo grau, válvula linear.")

# ================================================================ 7. R1/n²
s = next(cont)
title(s, "Resistência equivalente da barra: modelo R₁/n²")
box(s, 0.6, 2.55, 6.0, 1.55, name="Equação R1n2")
add_eq(s, "r1n2", "R_{eq}(n) = \\frac{R_1}{n^2}, \\qquad R_1 = \\frac{1}{K^2}", 0.95, 2.72, size=26, max_w=5.4)
text(s, 0.6, 4.3, 6.0, 2.7, [
    {"t": "n bicos iguais em paralelo: a resistência de um bico dividida por n²", "bullet": True},
    {"t": "Dobrar os bicos abertos divide a resistência por quatro", "bullet": True},
    {"t": "Substitui a fórmula empírica de Rosa et al. (quatro coeficientes sem significado físico) por um único parâmetro físico, K", "bullet": True}], size=16)
image(s, FIGS / "a_resistencia_n.png", 7.45, 2.45, h=3.2, name="Gráfico resistência")
stat(s, 6.95, 5.75, 2.8, "5,9%", "erro máximo do modelo R₁/n²", color=GREEN, big_size=30)
stat(s, 9.95, 5.75, 2.8, "18,5%", "erro da fórmula empírica (n = 7)", color=ORANGE, big_size=30)
notes(s, "A contribuição do modelo estático: com n bicos em paralelo, a resistência equivalente é a de um bico dividida por n ao quadrado. Um único parâmetro físico substitui uma fórmula empírica de quatro coeficientes. O erro relativo máximo foi 5,9%, contra 18,5% da fórmula empírica.")

